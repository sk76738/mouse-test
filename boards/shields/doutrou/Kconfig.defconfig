if SHIELD_DOUTROU_LEFT

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "doutrou"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_DOUTROU_LEFT || SHIELD_DOUTROU_RIGHT

config ZMK_SPLIT
    default y

endif

if SHIELD_DOUTROU_DONGLE

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "doutrou"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
  default 2

config BT_MAX_CONN
  default 7

config BT_MAX_PAIRED
  default 7

endif
